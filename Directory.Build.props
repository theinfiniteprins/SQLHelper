<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Compiler-correctness warnings (nullability, unreachable, unused) block the build.
         Code-analysis style suggestions surface as warnings but do not block. -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1014: CLSCompliant is irrelevant for an internal Windows-only tool.
         CA1822: several stateless service classes are kept as instances on purpose (test seams).
         CA1305: human-readable file headers/logs, not parsed back, and Windows is single-locale here.
         CA1859: perf micro-suggestions on interfaces kept for testability. -->
    <NoWarn>$(NoWarn);CA1014;CA1822;CA1305;CA1859</NoWarn>
    <Deterministic>true</Deterministic>
    <Company>SqlHelper</Company>
    <Product>SqlHelper</Product>
    <Version>0.1.0</Version>
    <!-- Microsoft.Data.SqlClient requires full ICU globalization; invariant mode is unsupported. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Every project restores only from the locked package graph; no accidental drift. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

</Project>
