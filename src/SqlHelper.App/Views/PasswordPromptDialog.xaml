<Window x:Class="SqlHelper.App.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set password" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <PasswordBox x:Name="Box" KeyDown="OnKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Set" Width="80" Style="{StaticResource PrimaryButton}" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
