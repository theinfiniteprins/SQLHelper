<Window x:Class="SqlHelper.App.Views.PlanReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlHelper.App.Controls"
        xmlns:vm="clr-namespace:SqlHelper.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:PatchViewModel}"
        Title="Check each client" Height="900" Width="1400" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceSunkBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Back to Patch" MinWidth="130"
                    Style="{StaticResource PrimaryButton}" Click="OnClose" IsCancel="True"
                    AutomationProperties.AutomationId="PlanReviewClose"/>
            <StackPanel>
                <TextBlock Text="What would change on each client" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                    Nothing here changes any database. Pick a client on the left (or use the arrow keys) to see exactly what
                    the patch would do to its copy. Ticks made here are the same ticks as on the Patch screen.
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Tick every clean match" Command="{Binding ApproveAllCleanCommand}"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource MutedText}">
                        <Run Text="{Binding ApprovedCount, Mode=OneWay}"/><Run Text=" ticked"/>
                    </TextBlock>
                </StackPanel>

                <DataGrid ItemsSource="{Binding PlanRows}" SelectedItem="{Binding SelectedPlanRow}"
                          IsReadOnly="False" AutoGenerateColumns="False" AutomationProperties.AutomationId="PlanReviewGrid">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Apply" Binding="{Binding IsApproved, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="170" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Match" Binding="{Binding Tier}" Width="60" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,0,0,10"
                        Visibility="{Binding SelectedPlanRow, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding SelectedPlanSummary}" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentPressedBrush}"/>
                </Border>

                <controls:DiffReviewPanel DataContext="{Binding SelectedDiff}" ShowExpandButton="False"
                                          EmptyMessage="Select a client on the left to see exactly what would change there."/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
