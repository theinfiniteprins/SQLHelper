<Window x:Class="SqlHelper.App.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SqlHelper" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="28">
        <TextBlock Text="🗄  SqlHelper" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,20"/>

        <TextBlock x:Name="PromptText" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PassphraseBox" KeyDown="OnKeyDown"/>
        <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource CritBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}"
                Margin="0,18,0,0" HorizontalAlignment="Right" Width="120" Click="OnContinue"/>
    </StackPanel>
</Window>
