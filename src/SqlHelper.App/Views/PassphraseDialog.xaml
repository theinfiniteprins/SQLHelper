<Window x:Class="SqlHelper.App.Views.PassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passphrase" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="ExplanationText" Style="{StaticResource FieldHint}" Margin="0,0,0,16"/>

        <TextBlock Text="Passphrase" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Box" PasswordChanged="OnChanged" KeyDown="OnKeyDown"/>

        <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
            <TextBlock Text="Type it again" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnChanged" KeyDown="OnKeyDown"/>
        </StackPanel>

        <TextBlock x:Name="ProblemText" Foreground="{StaticResource CritBrush}" TextWrapping="Wrap"
                   Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="OkButton" Content="Continue" Width="110" Style="{StaticResource PrimaryButton}"
                    Click="OnOk" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
