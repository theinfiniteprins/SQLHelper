<UserControl x:Class="SqlHelper.App.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SqlHelper.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:RegistryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <DockPanel>

        <!-- Heading -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Databases" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}">
                Every client database this tool can talk to. Add them here once and they become selectable on every other
                screen. Passwords are encrypted with Windows DPAPI and never leave this PC. Pasting from Excel expects these
                columns in order: Client, Server, Database, Auth, User, Environment, Trust certificate.
            </TextBlock>
        </StackPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="+  Add database" Style="{StaticResource PrimaryButton}" Command="{Binding AddRowCommand}"
                            AutomationProperties.AutomationId="AddDatabase"/>
                    <Button Content="Duplicate" Margin="8,0,0,0" Command="{Binding DuplicateRowCommand}"
                            IsEnabled="{Binding HasSelection}"/>
                    <Button Content="Remove" Margin="8,0,0,0" Command="{Binding RemoveSelectedCommand}"
                            IsEnabled="{Binding HasSelection}"/>
                    <Border Width="1" Background="{StaticResource BorderSoftBrush}" Margin="12,2"/>
                    <Button Content="Paste rows from Excel" Command="{Binding ImportFromClipboardCommand}"
                            ToolTip="Copy a range in Excel with these columns, in order: Client, Server, Database, Auth (Windows/Sql), User, Environment, Trust certificate (yes/no). Trailing columns can be left off."/>
                    <Border Width="1" Background="{StaticResource BorderSoftBrush}" Margin="12,2"/>
                    <Button Content="Export…" Command="{Binding ExportDatabasesCommand}"
                            AutomationProperties.AutomationId="ExportDatabases"
                            ToolTip="Write this whole list — passwords included — to one encrypted file you can give to a colleague"/>
                    <Button Content="Import…" Margin="8,0,0,0" Command="{Binding ImportDatabasesCommand}"
                            AutomationProperties.AutomationId="ImportDatabases"
                            ToolTip="Load a list exported from another PC"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Border Style="{StaticResource Pill}" Background="{StaticResource WarnSoftBrush}" VerticalAlignment="Center"
                            Margin="0,0,10,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Unsaved changes" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                    </Border>
                    <Button Content="Revert" Command="{Binding RevertCommand}"
                            IsEnabled="{Binding IsDirty}"/>
                    <Button Content="Save" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" MinWidth="90"
                            Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveRegistry"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status line -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,9" CornerRadius="5"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource CritSoftBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource CritBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Master / detail -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                             ItemContainerStyle="{StaticResource RecordListItem}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplaySubtitle}" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="!" FontWeight="Bold" Foreground="{StaticResource CritBrush}"
                                                   Margin="0,0,6,0" ToolTip="{Binding ValidationMessage}"
                                                   Visibility="{Binding IsValid, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        <Border Style="{StaticResource Pill}"
                                                Background="{Binding IsProduction, Converter={StaticResource ProdToBrushConverter}}">
                                            <TextBlock Text="{Binding EnvironmentLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding IsProduction, Converter={StaticResource ProdToTextBrushConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding Rows.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                        <TextBlock Text="No databases yet" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource InkMutedBrush}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextAlignment="Center" Margin="0,6,0,0">
                            Click "Add database" above to register your first one, or paste a block of rows straight from Excel.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail form -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Nothing selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibleConverter}}">
                        <TextBlock Text="Select a database on the left, or add one." Foreground="{StaticResource InkMutedBrush}"/>
                    </StackPanel>

                    <!-- Test connection strip (docked so it never overlaps the form) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"
                                Visibility="{Binding SelectedRow, Converter={StaticResource NullToCollapsedConverter}}">
                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test connection" Command="{Binding TestConnectionCommand}"
                                    AutomationProperties.AutomationId="TestConnection"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"/>
                            <TextBlock Text="Checking…" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <Border Margin="0,10,0,0" Padding="11,8" CornerRadius="5"
                                Visibility="{Binding TestResult, Converter={StaticResource NullToCollapsedConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestFailed}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CritSoftBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontSize="12.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource CritBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedRow, Converter={StaticResource NullToCollapsedConverter}}">
                        <StackPanel DataContext="{Binding SelectedRow}" MaxWidth="640" HorizontalAlignment="Left">

                            <TextBlock Text="Connection details" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="Client name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ClientName"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="How this client is labelled everywhere in the tool — results, backups, the audit log."/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="ServerName"/>
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Exactly what you type into SSMS: SQL-01, SQL-01\INSTANCE, or host,1433."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Database" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="DatabaseName"/>
                                    <TextBlock Style="{StaticResource FieldHint}" Text="The client's database on that server."/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Authentication" Style="{StaticResource SectionHeader}" Margin="0,22,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sign in with" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{x:Static vm:RegistryRowViewModel.AuthModes}"
                                              SelectedItem="{Binding AuthMode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Environment" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{x:Static vm:RegistryRowViewModel.Environments}"
                                              SelectedItem="{Binding Environment}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource FieldHint}"
                                               Text="Production targets are flagged everywhere in the tool, and ask you to confirm before anything is written."/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding IsSqlLogin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="User name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="PasswordEntry" PasswordChanged="OnPasswordChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding PasswordStatus}" Style="{StaticResource FieldHint}"/>

                            <CheckBox Content="Trust the server certificate" IsChecked="{Binding TrustServerCertificate}"
                                      AutomationProperties.AutomationId="TrustCert" Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource FieldHint}">
                                Connections are encrypted by default. Most internal SQL Servers use a self-signed certificate that
                                this PC doesn't trust — if Test connection complains about the certificate chain, tick this.
                            </TextBlock>

                            <TextBlock Text="Options" Style="{StaticResource SectionHeader}" Margin="0,22,0,10"/>

                            <CheckBox Content="Enabled — include this database in operations" IsChecked="{Binding Enabled}"/>

                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,14,0,3"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
