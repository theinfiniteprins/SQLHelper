<Window x:Class="SqlHelper.App.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SqlHelper.App.Controls"
        Title="Comparing changes" Height="900" Width="1400" WindowState="Maximized"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Nothing here changes any database — this is the comparison only."
                           Style="{StaticResource MutedText}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Content="Back to the list" MinWidth="140" Style="{StaticResource PrimaryButton}"
                    Click="OnClose" IsCancel="True"/>
        </DockPanel>

        <controls:DiffReviewPanel ShowExpandButton="False"/>
    </DockPanel>
</Window>
