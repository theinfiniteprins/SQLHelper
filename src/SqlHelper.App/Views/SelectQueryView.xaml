<UserControl x:Class="SqlHelper.App.Views.SelectQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SqlHelper.App.ViewModels"
             xmlns:controls="clr-namespace:SqlHelper.App.Controls"
             d:DataContext="{d:DesignInstance vm:SelectQueryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Select Query" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}">
                    Run one read-only query against as many client databases as you like and see the answer per client.
                    Only SELECT statements are allowed here — anything that writes is refused, and every query also runs
                    inside a transaction that is rolled back.
                </TextBlock>
            </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Query" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource CodeBox}" Height="150"
                             AutomationProperties.AutomationId="SqlText"
                             Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Border Style="{StaticResource CritBanner}" Margin="0,10,0,0"
                            Visibility="{Binding GuardWarning, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding GuardWarning}" TextWrapping="Wrap" Foreground="{StaticResource CritBrush}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Run query" Style="{StaticResource PrimaryButton}" MinWidth="110"
                                AutomationProperties.AutomationId="RunQuery"
                                Command="{Binding RunCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                                IsEnabled="{Binding CanCancel}"/>
                        <Border Width="1" Background="{StaticResource BorderSoftBrush}" Margin="14,2"/>
                        <Button Content="Export — one sheet" Command="{Binding ExportCombinedCommand}"
                                ToolTip="All clients stacked in a single sheet with a Client column"/>
                        <Button Content="Export — sheet per client" Margin="8,0,0,0" Command="{Binding ExportPerClientCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <TabControl ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedTab}"
                                Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ClientName}"/>
                                    <Border Margin="7,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource CritSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource CritBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource CritBanner}" Margin="0,0,0,10"
                                            Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="This database returned an error" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CritBrush}"/>
                                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{StaticResource CritBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border DockPanel.Dock="Bottom" Style="{StaticResource WarnBanner}" Margin="0,10,0,0"
                                            Visibility="{Binding Truncated, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Row limit reached — more rows exist than are shown here."
                                                   Foreground="{StaticResource WarnBrush}"/>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding PrimaryTable}" IsReadOnly="True" AutoGenerateColumns="True"
                                              AutoGeneratingColumn="OnAutoGeneratingColumn"
                                              Visibility="{Binding Success, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Results.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                        <TextBlock Text="No results yet" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource InkMutedBrush}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="380"
                                   Text="Write a SELECT above, tick the databases on the right, then Run query. You get one tab per client."/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <controls:TargetPickerControl Grid.Column="2" DataContext="{Binding Picker}"/>
    </Grid>
</UserControl>
