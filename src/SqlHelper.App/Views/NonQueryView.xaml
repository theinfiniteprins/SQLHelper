<UserControl x:Class="SqlHelper.App.Views.NonQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SqlHelper.App.ViewModels"
             xmlns:controls="clr-namespace:SqlHelper.App.Controls"
             d:DataContext="{d:DesignInstance vm:NonQueryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Update / Delete" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}">
                    Data corrections that need to run on many clients. Always start with a dry run: the script executes
                    inside a transaction, reports the rows it would touch per client, then rolls back. Only when the
                    numbers look right do you untick it and run for real.
                </TextBlock>
            </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="What is this change? (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ChangeTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="e.g. Fix rounding on 2026 invoices"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ticket (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Ticket, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="Optional, but worth filling in — it is written to the audit log alongside the script and the row counts."/>

                    <TextBlock Text="Script" Style="{StaticResource FieldLabel}" Margin="0,14,0,3"/>
                    <TextBox Style="{StaticResource CodeBox}" Height="170"
                             Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource FieldHint}"
                               Text="UPDATE / DELETE / INSERT, multiple batches separated by GO are fine. Each database gets its own transaction."/>

                    <Border Style="{StaticResource WarnBanner}" Margin="0,12,0,0"
                            Visibility="{Binding IsDryRun, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                                   Text="Dry run is off — this will commit for real. You will be asked to confirm before anything is written."/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Dry run (roll back, just report row counts)" IsChecked="{Binding IsDryRun}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="{Binding IsDryRun, Converter={StaticResource DryRunButtonLabelConverter}}"
                                Style="{StaticResource PrimaryButton}" MinWidth="140" Command="{Binding RunCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}"/>
                        <Button Content="Re-run failed only" Margin="8,0,0,0" Command="{Binding RunFailedOnlyCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False"
                              Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="200"/>
                            <DataGridTemplateColumn Header="Result" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource CritSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource CritBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rows affected" Binding="{Binding RowsAffected, StringFormat={}{0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Results.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                        <TextBlock Text="Nothing has run yet" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource InkMutedBrush}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="420"
                                   Text="Fill in a change title and your script, tick the databases, then start with a dry run. Row counts per client appear here."/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <controls:TargetPickerControl Grid.Column="2" DataContext="{Binding Picker}"/>
    </Grid>
</UserControl>
