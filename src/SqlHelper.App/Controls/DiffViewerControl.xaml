<UserControl x:Class="SqlHelper.App.Controls.DiffViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SqlHelper.App.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:EqualsMultiConverter x:Key="EqualsMulti"/>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="5"
            Background="{StaticResource SurfaceBrush}">
        <Grid>
            <!--
                Item-based scrolling keeps the list virtualised, so a 5,000-line procedure stays fast,
                and makes a vertical offset mean "this many lines down" - which is what lets a jump put
                a change at the top of the view precisely.
            -->
            <ListBox x:Name="LineList" ItemsSource="{Binding Lines, ElementName=Root}"
                     BorderThickness="0" Background="Transparent"
                     SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     HorizontalContentAlignment="Left"
                     AutomationProperties.Name="Diff lines">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy selected lines" InputGestureText="Ctrl+C" Click="OnCopySelected"/>
                        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="OnSelectAll"/>
                        <Separator/>
                        <MenuItem Header="Copy the whole new version" Click="OnCopyAfter"/>
                        <MenuItem Header="Copy the whole old version" Click="OnCopyBefore"/>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Border x:Name="SelectionOverlay" Background="{StaticResource AccentBrush}"
                                                Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionOverlay" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Every row is as wide as the longest line, so long lines scroll steadily and the colour runs edge to edge. -->
                        <Border x:Name="Row" Padding="0,1" MinWidth="{Binding RowWidth, ElementName=Root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Inserted">
                                            <Setter Property="Background" Value="#E3F3E8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                            <Setter Property="Background" Value="#FBE4E2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Modified">
                                            <Setter Property="Background" Value="#FBEEDA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Marks the lines of the change the navigation is on. -->
                                <Border Grid.Column="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                            <Binding Path="ChangeIndex"/>
                                                            <Binding Path="CurrentChange" ElementName="Root"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding LineNumberText}" TextAlignment="Right"
                                           Margin="0,0,8,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{StaticResource InkFaintBrush}"/>

                                <TextBlock Grid.Column="2" Text="{Binding Prefix}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Inserted">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                                    <Setter Property="Foreground" Value="{StaticResource CritBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="3" Text="{Binding DisplayText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" TextWrapping="NoWrap" Margin="0,0,10,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyMessage, ElementName=Root}" Style="{StaticResource FieldHint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="{Binding Lines.Count, ElementName=Root, Converter={StaticResource ZeroCountToVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>
