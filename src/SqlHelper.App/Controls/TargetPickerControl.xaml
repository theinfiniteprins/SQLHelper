<UserControl x:Class="SqlHelper.App.Controls.TargetPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SqlHelper.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:TargetPickerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Border Style="{StaticResource Card}" Padding="0">
        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top" Padding="13,12,13,10" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Run on" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding Items.Count, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,0"
                               Text="Tick the client databases this should run against."
                               Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Controls -->
            <StackPanel DockPanel.Dock="Top" Margin="13,10,13,8"
                        Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search" ToolTip="Filter by client, server or database name"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Select all" Style="{StaticResource QuietButton}" Command="{Binding SelectAllVisibleCommand}"/>
                    <Button Content="Clear" Style="{StaticResource QuietButton}" Margin="4,0,0,0" Command="{Binding SelectNoneCommand}"/>
                </StackPanel>
                <Grid Margin="0,6,0,0" Visibility="{Binding GroupNames.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding GroupNames}" SelectedItem="{Binding SelectedGroup}" Tag="Group"/>
                    <Button Grid.Column="1" Content="Apply" Margin="6,0,0,0" Command="{Binding ApplyGroupCommand}"/>
                </Grid>
            </StackPanel>

            <!-- List / empty state -->
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding View}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="13,7" BorderThickness="0,0,0,1" BorderBrush="{StaticResource SurfaceSunkBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Target.QualifiedName}"/>
                                        <StackPanel Grid.Column="1" Margin="9,0,6,0">
                                            <TextBlock Text="{Binding Target.ClientName}" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Target.QualifiedName}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center"
                                                Background="{Binding IsProduction, Converter={StaticResource ProdToBrushConverter}}">
                                            <TextBlock Text="{Binding EnvironmentLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding IsProduction, Converter={StaticResource ProdToTextBrushConverter}}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" Margin="18"
                            Visibility="{Binding Items.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                    <TextBlock Text="No databases yet" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{StaticResource InkMutedBrush}"/>
                    <TextBlock Style="{StaticResource FieldHint}" TextAlignment="Center" Margin="0,6,0,0"
                               Text="Open the Databases screen and register one first. Only enabled databases appear here."/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
